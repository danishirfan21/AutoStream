// qVehicles: generated by tools/make_bundles.py from queries/Vehicles.pq and its dependencies. Do not edit by hand.
// Reads DataFolder and SyntheticFixtureMode from tblConfig (Config sheet).
let
Config = Excel.CurrentWorkbook(){[Name = "tblConfig"]}[Content],
DataFolder = let ov = Config{[Setting = "DataFolderOverride"]}[Value] in if ov = null or Text.Trim(Text.From(ov)) = "" then Text.From(Config{[Setting = "DataFolderDefault"]}[Value]) else Text.From(ov),
Vehicles = (
let
    Folder = Text.TrimEnd(DataFolder, {"\", "/"}),
    Source = Csv.Document(File.Contents(Folder & "\vehicles.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Expected = {"vin", "year", "make", "model", "trim"},
    Selected = Table.SelectColumns(Promoted, Expected, MissingField.Error),
    AsText = Table.TransformColumnTypes(Selected, List.Transform(Expected, (c) => {c, type text}))
in
    AsText
)
in
    Vehicles
