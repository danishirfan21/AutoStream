// qFindings: generated by tools/make_bundles.py from queries/Findings.pq and its dependencies. Do not edit by hand.
// Reads DataFolder and SyntheticFixtureMode from tblConfig (Config sheet).
let
Config = Excel.CurrentWorkbook(){[Name = "tblConfig"]}[Content],
DataFolder = let ov = Config{[Setting = "DataFolderOverride"]}[Value] in if ov = null or Text.Trim(Text.From(ov)) = "" then Text.From(Config{[Setting = "DataFolderDefault"]}[Value]) else Text.From(ov),
SyntheticFixtureMode = Text.Lower(Text.From(Config{[Setting = "SyntheticFixtureMode"]}[Value])) = "true",
SourceMap = (
[
    dealer_csv = [
        vin = "vin", timestamp = "updated_at", year = "year", make = "make", model = "model", trim = "trim",
        mileage = "mileage", price = "price", record_key = "vin"
    ],
    marketplace_json = [
        vin = "vehicle_vin", timestamp = "updated", year = "model_year", make = "brand", model = "vehicle_model",
        trim = "variant", mileage = "odometer_miles", price = "asking_price", record_key = "listing_id"
    ]
]
),
Lib = (
[
    Columns = {"finding_id", "issue_type", "rule_id", "evidence_class", "assessment", "confirmed_invalid_input",
               "confirmed_pipeline_defect", "counts_as_actionable", "vin", "field", "source_a", "source_record_id_a",
               "timestamp_a", "value_a", "source_b", "source_record_id_b", "timestamp_b", "value_b",
               "pipeline_error_type_evidence", "distinct_record_count", "occurrences_canonical_sequence",
               "explained_by_finding_id", "derived_from", "fixture_evidence"},
    NoTs = "NO_SOURCE_TIMESTAMP",
    Attributes = {"year", "make", "model", "trim"},
    EmptyRow = Record.FromList(List.Repeat({""}, List.Count(Columns)), Columns),

    Blank = (pKv as record) as record =>
        Record.Combine({EmptyRow, [confirmed_pipeline_defect = "none_demonstrated"], pKv}),

    ToTable = (pRows as list) as table =>
        if List.IsEmpty(pRows) then #table(Columns, {}) else Table.FromRecords(pRows),

    CandTable = (pRows as list) as table =>
        if List.IsEmpty(pRows) then #table({"vin", "scope", "tskey", "fields", "rids"}, {}) else Table.FromRecords(pRows),

    SortOrd = (pList as list) as list => List.Sort(pList, Comparer.Ordinal),

    PyStr = (pRec as record, pField as text) as text =>
        if not Record.HasFields(pRec, pField) then ""
        else
            let xv = Record.Field(pRec, pField)
            in if xv = null then "None" else Text.From(xv, "en-US"),

    Norm = (pValue as any) as nullable text =>
        if pValue = null then null
        else
            let xt = Text.Trim(Text.From(pValue, "en-US"))
            in if xt = "" then null else xt,

    Field = (pPayload as record, pSource as text, pLogical as text) as nullable text =>
        let
            xName = Record.Field(Record.Field(SourceMap, pSource), pLogical),
            xValue = Record.FieldOrDefault(pPayload, xName, null)
        in
            Norm(xValue),

    ParseMileage = (pText as nullable text) as nullable number =>
        if pText = null then null
        else
            let
                xd = Text.Select(pText, {"0".."9", "-"}),
                xbody = if Text.StartsWith(xd, "-") then Text.Range(xd, 1) else xd,
                xok = xbody <> "" and Text.Select(xbody, {"0".."9"}) = xbody
            in
                if xok then Number.FromText(xd, "en-US") else null,

    CmpSR = (pA as record, pB as record) as number =>
        let xc = Comparer.Ordinal(pA[source_name], pB[source_name])
        in if xc <> 0 then xc else Comparer.Ordinal(pA[source_record_id], pB[source_record_id]),

    TsGroups = (pRecs as list) as nullable list =>
        if List.Count(pRecs) >= 2 and List.AnyTrue(List.Transform(pRecs, (xr) => xr[ts] = null)) then null
        else
            let xkeys = List.Sort(List.Distinct(List.Transform(pRecs, (xr) => xr[ts])))
            in List.Transform(xkeys, (xk) => List.Sort(List.Select(pRecs, (xr) => xr[ts] = xk), CmpSR)),

    ScopeOf = (pRecs as list) as text =>
        let xs = List.Distinct(List.Transform(pRecs, (xr) => xr[source_name]))
        in if List.Count(xs) = 1 then xs{0} else "*",

    Amb = (pVin as text, pRecs as list, pTs as text, pFields as list) as record =>
        [
            vin = pVin,
            scope = ScopeOf(pRecs),
            tskey = if pTs = "" then NoTs else pTs,
            fields = pFields,
            rids = List.Transform(pRecs, (xr) => xr[source_name] & ":" & xr[source_record_id])
        ],

    DifferingFields = (pGroup as list, pFields as list) as list =>
        List.Select(pFields, (xf) =>
            List.Count(List.Distinct(List.RemoveNulls(List.Transform(pGroup, (xr) => Record.Field(xr, xf))))) > 1)
]
),
Raw_SourceRecords = (
let
    Folder = Text.TrimEnd(DataFolder, {"\", "/"}),
    Source = Csv.Document(File.Contents(Folder & "\source_records.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Expected = {"vin", "source_name", "source_record_id", "source_timestamp_utc", "payload_hash", "raw_payload_json"},
    Selected = Table.SelectColumns(Promoted, Expected, MissingField.Error),
    AsText = Table.TransformColumnTypes(Selected, List.Transform(Expected, (c) => {c, type text}))
in
    AsText
),
SourceRecords = (
let
    Raw = Raw_SourceRecords,
    TsText = Table.TransformColumns(Raw, {{"source_timestamp_utc", (x) => if x = null then "" else x, type text}}),
    WithPayload = Table.AddColumn(TsText, "payload",
        (r) => Json.Document(Text.ToBinary(r[raw_payload_json], TextEncoding.Utf8)), type record),
    WithTs = Table.AddColumn(WithPayload, "ts",
        (r) => if r[source_timestamp_utc] = "" then null
               else try DateTimeZone.ToUtc(DateTimeZone.FromText(r[source_timestamp_utc])) otherwise null,
        type nullable datetimezone),
    WithAttrs = List.Accumulate(Lib[Attributes], WithTs,
        (state, f) => Table.AddColumn(state, f, (r) => Lib[Field](r[payload], r[source_name], f), type nullable text)),
    WithMileage = Table.AddColumn(WithAttrs, "mileage",
        (r) => Lib[ParseMileage](Lib[Field](r[payload], r[source_name], "mileage")), type nullable number),
    Result = Table.RemoveColumns(WithMileage, {"payload"})
in
    Result
),
F_AttributeFindings = (
let
    Recs = Table.ToRecords(SourceRecords),
    Attrs = Lib[Attributes],
    Vins = Lib[SortOrd](List.Distinct(List.Transform(Recs, (xr) => xr[vin]))),

    ConflictRow = (xVin as text, xf as text, a as record, b as record) as record =>
        Lib[Blank]([
            finding_id = "ATTR_CONFLICT|" & xVin & "|" & xf & "|" & a[src] & "~" & b[src],
            issue_type = "ATTR_CONFLICT",
            rule_id = "ATTR_CROSS_SOURCE_AGREEMENT",
            evidence_class = "SOURCE_DISCREPANCY",
            assessment = "SUSPICIOUS_REQUIRES_INVESTIGATION",
            confirmed_invalid_input = "undetermined",
            counts_as_actionable = "yes",
            vin = xVin,
            field = xf,
            source_a = a[src],
            source_record_id_a = a[rec][source_record_id],
            timestamp_a = a[rec][source_timestamp_utc],
            value_a = Record.Field(a[rec], xf),
            source_b = b[src],
            source_record_id_b = b[rec][source_record_id],
            timestamp_b = b[rec][source_timestamp_utc],
            value_b = Record.Field(b[rec], xf),
            derived_from = "FIXTURE_CONTENT",
            fixture_evidence = "Latest record per source by source timestamp disagrees on " & xf & ": "
                & Record.Field(a[rec], xf) & " vs " & Record.Field(b[rec], xf) & "."
                & (if a[flag] or b[flag] then " A source timestamp is missing on a single record (flagged)." else "")
        ]),

    DriftRow = (xVin as text, xf as text, xSrc as text, xRid as text, ka as record, kb as record) as record =>
        Lib[Blank]([
            finding_id = "ATTR_DRIFT|" & xVin & "|" & xf & "|" & xSrc & "|" & kb[rec][source_timestamp_utc],
            issue_type = "ATTR_DRIFT",
            rule_id = "ATTR_SAME_SOURCE_STABILITY",
            evidence_class = "SOURCE_DISCREPANCY",
            assessment = "OBSERVED_CHANGE_UNVERIFIED",
            confirmed_invalid_input = "undetermined",
            counts_as_actionable = "yes",
            vin = xVin,
            field = xf,
            source_a = xSrc,
            source_record_id_a = xRid,
            timestamp_a = ka[rec][source_timestamp_utc],
            value_a = ka[val],
            source_b = xSrc,
            source_record_id_b = xRid,
            timestamp_b = kb[rec][source_timestamp_utc],
            value_b = kb[val],
            derived_from = "FIXTURE_CONTENT",
            fixture_evidence = "Same source record changed " & xf & ": " & ka[val] & " -> " & kb[val] & " ("
                & ka[rec][source_timestamp_utc] & " -> " & kb[rec][source_timestamp_utc]
                & "). May be a correction; cause unknown."
        ]),

    PerVin = (xVin as text) as record =>
        let
            vr = List.Select(Recs, (xr) => xr[vin] = xVin),
            srcs = Lib[SortOrd](List.Distinct(List.Transform(vr, (xr) => xr[source_name]))),

            LatestOne = (xSrc as text) as record =>
                let
                    sr = List.Select(vr, (xr) => xr[source_name] = xSrc),
                    groups = Lib[TsGroups](sr)
                in
                    if groups = null then
                        [Entries = {},
                         Amb = {Lib[Amb](xVin, List.Select(sr, (xr) => xr[ts] = null), "", Attrs)}]
                    else
                        let
                            lastGrp = List.Last(groups),
                            bad = Lib[DifferingFields](lastGrp, Attrs),
                            ents = List.RemoveNulls(List.Transform(Attrs, (xf) =>
                                if List.Contains(bad, xf) then null
                                else
                                    let xrec = List.First(List.Select(lastGrp, (xr) => Record.Field(xr, xf) <> null), null)
                                    in if xrec = null then null
                                       else [fld = xf, src = xSrc, rec = xrec,
                                             flag = (List.Count(sr) = 1 and xrec[ts] = null)]))
                        in
                            [Entries = ents,
                             Amb = if List.IsEmpty(bad) then {}
                                   else {Lib[Amb](xVin, lastGrp, lastGrp{0}[source_timestamp_utc], bad)}],
            latestRes = List.Transform(srcs, LatestOne),
            entries = List.Combine(List.Transform(latestRes, (x) => x[Entries])),
            ambLatest = List.Combine(List.Transform(latestRes, (x) => x[Amb])),

            ConflictsFor = (xf as text) as list =>
                let
                    es = List.Sort(List.Select(entries, (e) => e[fld] = xf),
                                   (p, q) => Comparer.Ordinal(p[src], q[src])),
                    n = List.Count(es),
                    pairs = List.Combine(List.Transform({0..n - 2},
                                (i) => List.Transform({i + 1..n - 1}, (j) => {es{i}, es{j}})))
                in
                    List.Transform(
                        List.Select(pairs, (pr) => Record.Field(pr{0}[rec], xf) <> Record.Field(pr{1}[rec], xf)),
                        (pr) => ConflictRow(xVin, xf, pr{0}, pr{1})),
            conflicts = List.Combine(List.Transform(Attrs, ConflictsFor)),

            ids = List.Sort(List.Distinct(List.Transform(vr, (xr) => {xr[source_name], xr[source_record_id]})),
                            (p, q) => let c = Comparer.Ordinal(p{0}, q{0}) in if c <> 0 then c else Comparer.Ordinal(p{1}, q{1})),
            DriftOne = (xid as list) as record =>
                let
                    xSrc = xid{0},
                    xRid = xid{1},
                    versions = List.Select(vr, (xr) => xr[source_name] = xSrc and xr[source_record_id] = xRid),
                    groups = Lib[TsGroups](versions)
                in
                    if groups = null then
                        [Drifts = {}, Amb = {Lib[Amb](xVin, versions, "", Attrs)}]
                    else
                        let
                            PerField = (xf as text) as record =>
                                let
                                    badGrps = List.Select(groups, (g) =>
                                        List.Count(List.Distinct(List.RemoveNulls(List.Transform(g, (xr) => Record.Field(xr, xf))))) > 1),
                                    known = List.Transform(
                                        List.Select(groups, (g) => List.Count(List.RemoveNulls(List.Transform(g, (xr) => Record.Field(xr, xf)))) > 0),
                                        (g) => [rec = g{0}, val = List.First(List.RemoveNulls(List.Transform(g, (xr) => Record.Field(xr, xf))))]),
                                    k = List.Count(known),
                                    changed = List.Select({0..k - 2}, (i) => known{i}[val] <> known{i + 1}[val])
                                in
                                    if not List.IsEmpty(badGrps) then
                                        [Drifts = {},
                                         Amb = List.Transform(badGrps, (g) => Lib[Amb](xVin, g, g{0}[source_timestamp_utc], {xf}))]
                                    else
                                        [Drifts = List.Transform(changed, (i) => DriftRow(xVin, xf, xSrc, xRid, known{i}, known{i + 1})),
                                         Amb = {}],
                            perF = List.Transform(Attrs, PerField)
                        in
                            [Drifts = List.Combine(List.Transform(perF, (x) => x[Drifts])),
                             Amb = List.Combine(List.Transform(perF, (x) => x[Amb]))],
            driftRes = List.Transform(ids, DriftOne)
        in
            [Conflicts = conflicts,
             Drifts = List.Combine(List.Transform(driftRes, (x) => x[Drifts])),
             Amb = List.Combine({ambLatest, List.Combine(List.Transform(driftRes, (x) => x[Amb]))})],

    Results = List.Transform(Vins, PerVin),
    AllConflicts = List.Combine(List.Transform(Results, (x) => x[Conflicts])),
    AllDrifts = List.Combine(List.Transform(Results, (x) => x[Drifts])),
    AllAmb = List.Combine(List.Transform(Results, (x) => x[Amb])),
    Out = [Conflicts = Lib[ToTable](AllConflicts), Drifts = Lib[ToTable](AllDrifts), Candidates = Lib[CandTable](AllAmb)]
in
    Out
),
F_Mileage = (
let
    Recs = Table.ToRecords(SourceRecords),
    Vins = Lib[SortOrd](List.Distinct(List.Transform(Recs, (xr) => xr[vin]))),

    MkRow = (xVin as text, xPrev as record, xCur as record) as record =>
        Lib[Blank]([
            finding_id = "MILEAGE_REGRESSION|" & xVin & "|" & xCur[source_name] & "|" & xCur[source_record_id] & "|" & xCur[source_timestamp_utc],
            issue_type = "MILEAGE_REGRESSION",
            rule_id = "MILEAGE_NON_DECREASING",
            evidence_class = "SOURCE_DISCREPANCY",
            assessment = "SUSPICIOUS_REQUIRES_INVESTIGATION",
            confirmed_invalid_input = "undetermined",
            counts_as_actionable = "yes",
            vin = xVin,
            field = "mileage",
            source_a = xPrev[rec][source_name],
            source_record_id_a = xPrev[rec][source_record_id],
            timestamp_a = xPrev[rec][source_timestamp_utc],
            value_a = Text.From(xPrev[m], "en-US"),
            source_b = xCur[source_name],
            source_record_id_b = xCur[source_record_id],
            timestamp_b = xCur[source_timestamp_utc],
            value_b = Text.From(xCur[mileage], "en-US"),
            derived_from = "FIXTURE_CONTENT",
            fixture_evidence = "Mileage decreased " & Text.From(xPrev[m], "en-US") & " -> " & Text.From(xCur[mileage], "en-US")
                & " between consecutive observations ordered by source timestamp (" & xPrev[rec][source_timestamp_utc]
                & " -> " & xCur[source_timestamp_utc] & "). Anomaly flag only; not proof of corruption."
        ]),

    PerVin = (xVin as text) as record =>
        let
            vr = List.Select(Recs, (xr) => xr[vin] = xVin),
            groups = Lib[TsGroups](vr),
            Step = (st as record, g as list) as record =>
                let
                    vals = List.RemoveNulls(List.Transform(g, (xr) => xr[mileage])),
                    cur = List.First(List.Select(g, (xr) => xr[mileage] <> null), null)
                in
                    if List.Count(List.Distinct(vals)) > 1 then
                        [Prev = null, Findings = st[Findings],
                         Amb = st[Amb] & {Lib[Amb](xVin, g, g{0}[source_timestamp_utc], {"mileage"})}]
                    else if List.IsEmpty(vals) then st
                    else
                        [Prev = [rec = cur, m = cur[mileage]],
                         Findings = if st[Prev] <> null and cur[mileage] < st[Prev][m]
                                    then st[Findings] & {MkRow(xVin, st[Prev], cur)} else st[Findings],
                         Amb = st[Amb]]
        in
            if groups = null then
                [Findings = {}, Amb = {Lib[Amb](xVin, List.Select(vr, (xr) => xr[ts] = null), "", {"mileage"})}]
            else
                let acc = List.Accumulate(groups, [Prev = null, Findings = {}, Amb = {}], Step)
                in [Findings = acc[Findings], Amb = acc[Amb]],

    Results = List.Transform(Vins, PerVin),
    AllFindings = List.Combine(List.Transform(Results, (x) => x[Findings])),
    AllAmb = List.Combine(List.Transform(Results, (x) => x[Amb])),
    Out = [Findings = Lib[ToTable](AllFindings), Candidates = Lib[CandTable](AllAmb)]
in
    Out
),
F_Ambiguous = (
let
    Cand = Table.Combine({F_Mileage[Candidates], F_AttributeFindings[Candidates]}),
    Rows = Table.ToRecords(Cand),
    Keys = List.Distinct(List.Transform(Rows, (xr) => {xr[vin], xr[scope], xr[tskey]})),
    Out = List.Transform(Keys, (xk) =>
        let
            items = List.Select(Rows, (xr) => xr[vin] = xk{0} and xr[scope] = xk{1} and xr[tskey] = xk{2}),
            xFields = Lib[SortOrd](List.Distinct(List.Combine(List.Transform(items, (xr) => xr[fields])))),
            xRids = Lib[SortOrd](List.Distinct(List.Combine(List.Transform(items, (xr) => xr[rids])))),
            xFieldText = Text.Combine(xFields, ",")
        in
            Lib[Blank]([
                finding_id = "AMBIGUOUS_ORDER|" & xk{0} & "|" & xk{1} & "|" & xk{2},
                issue_type = "AMBIGUOUS_ORDER",
                rule_id = "TIMESTAMP_ORDER_UNAMBIGUOUS",
                evidence_class = "ORDERING_AMBIGUITY",
                assessment = "AMBIGUOUS_NOT_RESOLVED",
                confirmed_invalid_input = "undetermined",
                counts_as_actionable = "yes",
                vin = xk{0},
                field = xFieldText,
                source_a = xk{1},
                timestamp_a = if xk{2} = Lib[NoTs] then "" else xk{2},
                value_a = "records=" & Text.Combine(xRids, ";"),
                derived_from = "FIXTURE_CONTENT",
                fixture_evidence = "Records cannot be ordered by source timestamp for field(s) " & xFieldText
                    & "; no value was selected and dependent comparisons were skipped."
            ])),
    Result = Lib[ToTable](Out)
in
    Result
),
Raw_IngestionErrors = (
let
    Folder = Text.TrimEnd(DataFolder, {"\", "/"}),
    Source = Csv.Document(File.Contents(Folder & "\ingestion_errors.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Expected = {"run_seq", "run_source_name", "occurrence_in_run", "stored_source_record_id", "error_type", "error_message", "raw_payload_json"},
    Selected = Table.SelectColumns(Promoted, Expected, MissingField.Error),
    AsText = Table.TransformColumnTypes(Selected, List.Transform(Expected, (c) => {c, type text}))
in
    AsText
),
F_Rejected = (
let
    Errors = Table.ToRecords(Raw_IngestionErrors),
    Known = Record.FieldNames(SourceMap),

    CfgField = (xSrc as nullable text, xName as text) as text =>
        if xSrc <> null and List.Contains(Known, xSrc) then Record.Field(Record.Field(SourceMap, xSrc), xName) else "",

    ClassifyRule = (xType as nullable text, xMsg as nullable text) as text =>
        if xType = "InvalidOperation" then "PRICE_NUMERIC"
        else if xType = "ValidationError" and xMsg <> null then
            let
                lines = Lines.FromText(xMsg),
                firstLine = if List.IsEmpty(lines) then "" else lines{0},
                pos = Text.PositionOf(firstLine, " validation error"),
                countText = if pos < 0 then "" else Text.Start(firstLine, pos),
                rest = if pos < 0 then "" else Text.Range(firstLine, pos + Text.Length(" validation error")),
                headerOk = countText <> "" and Text.Select(countText, {"0".."9"}) = countText
                           and (Text.StartsWith(rest, " for ") or Text.StartsWith(rest, "s for ")),
                IsIdent = (l as text) as logical =>
                    l <> "" and Text.Select(Text.Start(l, 1), {"A".."Z", "a".."z", "_"}) <> ""
                    and Text.Select(l, {"A".."Z", "a".."z", "0".."9", "_", "."}) = l,
                fields = List.Select(lines, IsIdent)
            in
                if headerOk and countText = "1" and fields = {"vin"} then "VIN_FORMAT" else "UNCLASSIFIED"
        else "UNCLASSIFIED",

    Violates = (xRule as text, xSrc as text, xp as record) as nullable logical =>
        if not List.Contains(Known, xSrc) then null
        else if xRule = "VIN_FORMAT" then
            let xv = Text.Upper(Text.Trim(Lib[PyStr](xp, CfgField(xSrc, "vin"))))
            in not (Text.Length(xv) = 17 and Text.Select(xv, {"A".."H", "J".."N", "P", "R".."Z", "0".."9"}) = xv)
        else if xRule = "PRICE_NUMERIC" then
            let
                xt = Text.Remove(Lib[PyStr](xp, CfgField(xSrc, "price")), {" ", "$", ",", "#(tab)", "#(lf)", "#(cr)"}),
                parts = Text.Split(xt, "."),
                ok = (List.Count(parts) = 1 or List.Count(parts) = 2)
                     and List.AllTrue(List.Transform(parts, (x) => x <> "" and Text.Select(x, {"0".."9"}) = x))
            in not ok
        else null,

    Parsed = List.Transform(Errors, (xe) =>
        let
            xSrc = xe[run_source_name],
            xp = Json.Document(Text.ToBinary(xe[raw_payload_json], TextEncoding.Utf8)),
            xRule = ClassifyRule(xe[error_type], xe[error_message]),
            xKeyRaw = Text.Trim(Lib[PyStr](xp, CfgField(xSrc, "record_key"))),
            xKey = if xKeyRaw <> "" then xKeyRaw else xe[stored_source_record_id],
            xTsVal = Record.FieldOrDefault(xp, CfgField(xSrc, "timestamp"), null),
            xTsText = if xTsVal = null or xTsVal = "" then "" else Text.From(xTsVal, "en-US"),
            xTs = if xTsText = "" then Lib[NoTs] else xTsText
        in
            [fid = "REJECTED_RECORD|" & xSrc & "|" & xKey & "|" & xRule & "|" & xTs,
             src = xSrc, rule = xRule, ts = xTs, stored = xe[stored_source_record_id], p = xp,
             ptext = xe[raw_payload_json], etype = xe[error_type]]),

    Fids = List.Distinct(List.Transform(Parsed, (xr) => xr[fid])),

    Rows = List.Transform(Fids, (xFid) =>
        let
            g = List.Select(Parsed, (xr) => xr[fid] = xFid),
            g0 = g{0},
            xSrc = g0[src],
            xRule = g0[rule],
            xp = g0[p],
            xFld = if xRule = "VIN_FORMAT" then CfgField(xSrc, "vin")
                   else if xRule = "PRICE_NUMERIC" then CfgField(xSrc, "price") else "",
            xDistinct = List.Count(List.Distinct(List.Transform(g, (xr) => xr[ptext]))),
            xOcc = List.Count(g)
        in
            Lib[Blank]([
                finding_id = xFid,
                issue_type = "REJECTED_RECORD",
                rule_id = xRule,
                evidence_class = "REJECTED_INPUT",
                assessment = "EXPECTED_REJECTION",
                confirmed_invalid_input = if Violates(xRule, xSrc, xp) = true then "yes" else "undetermined",
                counts_as_actionable = if SyntheticFixtureMode then "no" else "yes",
                vin = Lib[PyStr](xp, CfgField(xSrc, "vin")),
                field = xFld,
                source_a = xSrc,
                source_record_id_a = g0[stored],
                timestamp_a = if g0[ts] = Lib[NoTs] then "" else g0[ts],
                value_a = if xFld <> "" then xFld & "=" & Lib[PyStr](xp, xFld) else "",
                pipeline_error_type_evidence = Text.Combine(Lib[SortOrd](List.Distinct(List.Transform(g, (xr) => xr[etype]))), ";"),
                distinct_record_count = Text.From(xDistinct, "en-US"),
                occurrences_canonical_sequence = Text.From(xOcc, "en-US"),
                derived_from = "FIXTURE_CONTENT+PIPELINE_BEHAVIOR",
                fixture_evidence = Text.From(xOcc, "en-US") & " rejection occurrence(s) of " & Text.From(xDistinct, "en-US")
                    & " distinct payload(s) for rule " & xRule & "; stored record id " & g0[stored] & "."
            ])),

    Result = Lib[ToTable](Rows)
in
    Result
),
F_Coverage = (
let
    Recs = Table.ToRecords(SourceRecords),
    Known = Record.FieldNames(SourceMap),
    ErrSources = List.Select(List.Distinct(Raw_IngestionErrors[run_source_name]), (s) => s <> null and List.Contains(Known, s)),
    Sources = Lib[SortOrd](List.Distinct(List.Combine({List.Transform(Recs, (xr) => xr[source_name]), ErrSources}))),
    Rejected = Table.ToRecords(F_Rejected),
    Vins = Lib[SortOrd](List.Distinct(List.Transform(Recs, (xr) => xr[vin]))),

    RowsFor = (xVin as text) as list =>
        let
            vr = List.Select(Recs, (xr) => xr[vin] = xVin),
            present = Lib[SortOrd](List.Distinct(List.Transform(vr, (xr) => xr[source_name]))),
            missing = List.Select(Sources, (s) => not List.Contains(present, s))
        in
            List.Transform(missing, (xMissing) =>
                let
                    xSa = present{0},
                    xRa = List.First(List.Sort(List.Select(vr, (xr) => xr[source_name] = xSa),
                              (p, q) => let c = Comparer.Ordinal(q[source_timestamp_utc], p[source_timestamp_utc])
                                        in if c <> 0 then c else Comparer.Ordinal(q[source_record_id], p[source_record_id]))),
                    expl = Lib[SortOrd](List.Transform(
                              List.Select(Rejected, (r) => r[source_a] = xMissing and Text.Upper(Text.Trim(r[vin])) = xVin),
                              (r) => r[finding_id])),
                    xCls = if not List.IsEmpty(expl) then "COVERAGE_EXPLAINED"
                           else if SyntheticFixtureMode then "COVERAGE_FIXTURE_LIMITED"
                           else "COVERAGE_UNEXPLAINED",
                    xWhy = if xCls = "COVERAGE_EXPLAINED" then "A rejected record exists for this VIN in the missing source."
                           else if xCls = "COVERAGE_FIXTURE_LIMITED"
                           then "OBSERVATION CAUSED BY LIMITED SYNTHETIC FIXTURES; NOT A SOURCE DEFECT. Excluded from actionable defect counts."
                           else "No record and no rejected record in the missing source."
                in
                    Lib[Blank]([
                        finding_id = "COVERAGE_GAP|" & xVin & "|missing:" & xMissing,
                        issue_type = "COVERAGE_GAP",
                        rule_id = "SOURCE_COVERAGE",
                        evidence_class = xCls,
                        assessment = "COVERAGE_OBSERVATION",
                        confirmed_invalid_input = "not_applicable",
                        counts_as_actionable = if xCls = "COVERAGE_UNEXPLAINED" then "yes" else "no",
                        vin = xVin,
                        field = "source_presence",
                        source_a = xSa,
                        source_record_id_a = xRa[source_record_id],
                        timestamp_a = xRa[source_timestamp_utc],
                        value_a = "present",
                        source_b = xMissing,
                        value_b = "absent",
                        explained_by_finding_id = if List.IsEmpty(expl) then "" else expl{0},
                        derived_from = if List.IsEmpty(expl) then "FIXTURE_CONTENT" else "FIXTURE_CONTENT+PIPELINE_BEHAVIOR",
                        fixture_evidence = "VIN present in " & xSa & " accepted records, absent from " & xMissing & ". " & xWhy
                    ])),

    Result = Lib[ToTable](List.Combine(List.Transform(Vins, RowsFor)))
in
    Result
),
Findings = (
let
    Parts = {
        F_Mileage[Findings],
        F_AttributeFindings[Conflicts],
        F_AttributeFindings[Drifts],
        F_Rejected,
        F_Coverage,
        F_Ambiguous
    },
    All = Table.Combine(Parts),
    Ids = Table.Column(All, "finding_id"),
    Checked = if List.Count(Ids) <> List.Count(List.Distinct(Ids))
              then error "Duplicate finding_id values: finding ids must be unique"
              else All,
    Ordered = Table.SelectColumns(Checked, Lib[Columns]),
    Sorted = Table.Sort(Ordered, {{"issue_type", Order.Ascending}, {"finding_id", Order.Ascending}}),
    AsText = Table.TransformColumnTypes(Sorted, List.Transform(Lib[Columns], (c) => {c, type text}))
in
    AsText
)
in
    Findings
